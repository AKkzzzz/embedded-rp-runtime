{
  "schemaVersion": 1,
  "mode": "persistent-single-stage-galgame",
  "appId": "nanami-embedded-rp-runtime-template",
  "marker": "<<<nanami_embedded_rp_runtime_v1>>>",
  "storagePrefix": "nanami_embedded_rp_runtime_v1",
  "provenance": {
    "owner": "AKkzzzz",
    "projectType": "RP-Hub 单正则 + 插件功能的小卡底层",
    "license": "Community Source-Available Non-Commercial",
    "repositoryOwner": "AKkzzzz",
    "repository": "",
    "sourceNotice": "发布卡只包含压缩运行产物；开发源码、测试和构建工具不随卡分发。"
  },
  "entryHtml": "ui/index.html",
  "startupMode": "debug",
  "worldbook": {
    "selectiveLimit": 12,
    "charBudget": 26000,
    "maxDependencyDepth": 3,
    "scanMessageLimit": 12,
    "failOnCycle": false
  },
  "memory": {
    "structuredEnabled": true,
    "vectorEnabled": false,
    "vectorTopK": 8,
    "similarityThreshold": 0.3,
    "chunkChars": 700,
    "chunkOverlap": 100,
    "storageEncoding": "int8:maxabs:v1",
    "patrolEnabled": true,
    "patrolIntervalMs": 60000,
    "retryEnabled": true,
    "maxRetryAttempts": 6
  },
  "models": {
    "routes": [
      "narrative",
      "state",
      "summarize",
      "embedding"
    ],
    "credentialPolicy": "rphub-same-origin-read",
    "requestMode": "direct-openai-compatible",
    "streaming": true,
    "fallbackMode": "diagnostic-only"
  },
  "prompt": {
    "stylePriority": true,
    "regexChannels": ["prompt", "output"],
    "maxToolContinuationRounds": 4
  },
  "tools": [
    {
      "id": "tool_memory",
      "type": "vector_memory",
      "enabled": false,
      "capabilities": ["memory:read"]
    },
    {
      "id": "tool_grep",
      "type": "keyword_dialogue",
      "enabled": false,
      "capabilities": ["conversation:read"]
    },
    {
      "id": "tool_web",
      "type": "web_search",
      "enabled": false,
      "capabilities": ["network:search"]
    },
    {
      "id": "tool_dice",
      "type": "dice",
      "enabled": false,
      "capabilities": ["randomness:local"]
    },
    {
      "id": "tool_worldbook",
      "type": "worldbook",
      "enabled": false,
      "capabilities": ["worldbook:read"]
    }
  ],
  "plugins": [
    {
      "id": "runtime.worldbook.recursion",
      "version": "1.0.0",
      "enabled": true,
      "priority": 40,
      "requires": [],
      "optional": [],
      "capabilities": [
        "worldbook:read",
        "retrieval:extend"
      ]
    },
    {
      "id": "runtime.patch.guard",
      "version": "1.0.0",
      "enabled": true,
      "priority": 60,
      "requires": [],
      "optional": [],
      "capabilities": [
        "state:validate",
        "worldbook:patch:validate"
      ]
    },
    {
      "id": "runtime.timeline",
      "version": "0.1.0",
      "enabled": false,
      "priority": 80,
      "requires": [],
      "optional": [],
      "capabilities": ["events:listen", "timeline:read", "timeline:branch", "storage:local"]
    },
    {
      "id": "runtime.rpg-companion",
      "version": "0.1.0",
      "enabled": false,
      "priority": 90,
      "requires": [],
      "optional": [],
      "capabilities": ["state:read", "state:patch:propose", "prompt:modify", "ui:overlay", "storage:local"]
    },
    {
      "id": "runtime.command-registry",
      "version": "0.1.0",
      "enabled": false,
      "priority": 100,
      "requires": [],
      "optional": [],
      "capabilities": ["commands:register", "events:listen", "state:read", "ui:overlay"]
    },
    {
      "id": "runtime.variable-overlay",
      "version": "0.1.0",
      "enabled": false,
      "priority": 110,
      "requires": [],
      "optional": [],
      "capabilities": ["ui:overlay", "state:read", "events:listen"]
    },
    {
      "id": "runtime.dynamic-lore",
      "version": "0.1.0",
      "enabled": false,
      "priority": 120,
      "requires": [],
      "optional": [],
      "capabilities": ["worldbook:read", "retrieval:extend", "prompt:modify"]
    },
    {
      "id": "runtime.webllm",
      "version": "0.1.0",
      "enabled": false,
      "priority": 130,
      "requires": [],
      "optional": [],
      "capabilities": ["webllm:local", "storage:local"]
    },
    {
      "id": "runtime.media-stage",
      "version": "0.1.0",
      "enabled": false,
      "priority": 140,
      "requires": [],
      "optional": [],
      "capabilities": ["audio:play", "visual:effect", "assets:read", "ui:overlay"]
    },
    {
      "id": "runtime.prompt-inspector", "version": "0.1.0", "enabled": false, "priority": 150,
      "requires": [], "optional": [],
      "capabilities": ["prompt:inspect", "conversation:read", "worldbook:read", "memory:read", "state:read", "ui:overlay"]
    },
    {
      "id": "runtime.guided-generations", "version": "0.1.0", "enabled": false, "priority": 160,
      "requires": [], "optional": [],
      "capabilities": ["suggestions:generate", "prompt:modify", "state:read", "ui:overlay"]
    },
    {
      "id": "runtime.character-memory", "version": "0.1.0", "enabled": false, "priority": 170,
      "requires": [], "optional": [],
      "capabilities": ["memory:read", "memory:write", "memory:curate", "conversation:read", "ui:overlay"]
    },
    {
      "id": "runtime.notebook", "version": "0.1.0", "enabled": false, "priority": 180,
      "requires": [], "optional": [],
      "capabilities": ["notes:write", "prompt:modify", "storage:local", "ui:overlay"]
    },
    {
      "id": "runtime.persona-switcher", "version": "0.1.0", "enabled": false, "priority": 190,
      "requires": [], "optional": [],
      "capabilities": ["persona:switch", "state:patch:propose", "storage:local", "ui:overlay"]
    },
    {
      "id": "runtime.visual-novel", "version": "0.1.0", "enabled": false, "priority": 200,
      "requires": [], "optional": [],
      "capabilities": ["visual:effect", "ui:overlay", "assets:read"]
    },
    {
      "id": "runtime.diagram", "version": "0.1.0", "enabled": false, "priority": 210,
      "requires": [], "optional": [],
      "capabilities": ["diagrams:render", "ui:overlay"]
    },
    {
      "id": "runtime.parameter-randomizer", "version": "0.1.0", "enabled": false, "priority": 220,
      "requires": [], "optional": [],
      "capabilities": ["parameters:modify", "storage:local"]
    },
    {
      "id": "runtime.lore-copilot", "version": "0.1.0", "enabled": false, "priority": 230,
      "requires": [], "optional": [],
      "capabilities": ["worldbook:read", "worldbook:patch:propose", "conversation:read", "prompt:inspect", "ui:overlay"]
    },
    {
      "id": "runtime.lore-recommender", "version": "0.1.0", "enabled": false, "priority": 240,
      "requires": [], "optional": [],
      "capabilities": ["worldbook:read", "lore:diagnose", "prompt:inspect", "ui:overlay"]
    }
  ],
  "stage": {
    "desktop": {
      "maxWidth": 1280,
      "aspectRatio": "16/9",
      "viewportGap": 24,
      "heightGap": 72
    },
    "mobile": {
      "breakpoint": 720,
      "aspectRatio": "9/16",
      "viewportGap": 0,
      "heightGap": 0
    }
  }
}
