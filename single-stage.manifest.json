{
  "schemaVersion": 1,
  "mode": "persistent-single-stage-galgame",
  "appId": "nanami-embedded-rp-runtime-template",
  "marker": "<<<nanami_embedded_rp_runtime_v1>>>",
  "storagePrefix": "nanami_embedded_rp_runtime_v1",
  "entryHtml": "ui/index.html",
  "startupMode": "debug",
  "worldbook": {
    "selectiveLimit": 12,
    "charBudget": 26000,
    "maxDependencyDepth": 3,
    "scanMessageLimit": 12,
    "failOnCycle": false
  },
  "memory": {
    "structuredEnabled": true,
    "vectorEnabled": false,
    "vectorTopK": 8,
    "similarityThreshold": 0.3,
    "chunkChars": 700,
    "chunkOverlap": 100,
    "storageEncoding": "int8:maxabs:v1",
    "patrolEnabled": true,
    "patrolIntervalMs": 60000,
    "retryEnabled": true,
    "maxRetryAttempts": 6
  },
  "models": {
    "routes": [
      "narrative",
      "state",
      "summarize",
      "embedding"
    ],
    "credentialPolicy": "rphub-same-origin-read",
    "requestMode": "direct-openai-compatible",
    "streaming": true,
    "fallbackMode": "diagnostic-only"
  },
  "prompt": {
    "stylePriority": true,
    "regexChannels": ["prompt", "output"],
    "maxToolContinuationRounds": 4
  },
  "tools": [
    {
      "id": "tool_memory",
      "type": "vector_memory",
      "enabled": false,
      "capabilities": ["memory:read"]
    },
    {
      "id": "tool_grep",
      "type": "keyword_dialogue",
      "enabled": false,
      "capabilities": ["conversation:read"]
    },
    {
      "id": "tool_web",
      "type": "web_search",
      "enabled": false,
      "capabilities": ["network:search"]
    },
    {
      "id": "tool_dice",
      "type": "dice",
      "enabled": true,
      "capabilities": ["randomness:local"]
    }
  ],
  "plugins": [
    {
      "id": "runtime.worldbook.recursion",
      "version": "1.0.0",
      "enabled": true,
      "priority": 40,
      "requires": [],
      "optional": [],
      "capabilities": [
        "worldbook:read",
        "retrieval:extend"
      ]
    },
    {
      "id": "runtime.patch.guard",
      "version": "1.0.0",
      "enabled": true,
      "priority": 60,
      "requires": [],
      "optional": [],
      "capabilities": [
        "state:validate",
        "worldbook:patch:validate"
      ]
    },
    {
      "id": "runtime.timeline",
      "version": "0.1.0",
      "enabled": false,
      "priority": 80,
      "requires": [],
      "optional": [],
      "capabilities": ["events:listen", "timeline:read", "timeline:branch", "storage:local"]
    },
    {
      "id": "runtime.rpg-companion",
      "version": "0.1.0",
      "enabled": false,
      "priority": 90,
      "requires": [],
      "optional": [],
      "capabilities": ["state:read", "state:patch:propose", "prompt:modify", "ui:overlay", "storage:local"]
    },
    {
      "id": "runtime.command-registry",
      "version": "0.1.0",
      "enabled": false,
      "priority": 100,
      "requires": [],
      "optional": [],
      "capabilities": ["commands:register", "events:listen", "state:read", "ui:overlay"]
    },
    {
      "id": "runtime.variable-overlay",
      "version": "0.1.0",
      "enabled": false,
      "priority": 110,
      "requires": [],
      "optional": [],
      "capabilities": ["ui:overlay", "state:read", "events:listen"]
    },
    {
      "id": "runtime.dynamic-lore",
      "version": "0.1.0",
      "enabled": false,
      "priority": 120,
      "requires": [],
      "optional": [],
      "capabilities": ["worldbook:read", "retrieval:extend", "prompt:modify"]
    },
    {
      "id": "runtime.webllm",
      "version": "0.1.0",
      "enabled": false,
      "priority": 130,
      "requires": [],
      "optional": [],
      "capabilities": ["webllm:local", "storage:local"]
    },
    {
      "id": "runtime.media-stage",
      "version": "0.1.0",
      "enabled": false,
      "priority": 140,
      "requires": [],
      "optional": [],
      "capabilities": ["audio:play", "visual:effect", "assets:read", "ui:overlay"]
    }
  ],
  "stage": {
    "desktop": {
      "maxWidth": 1280,
      "aspectRatio": "16/9",
      "viewportGap": 24,
      "heightGap": 72
    },
    "mobile": {
      "breakpoint": 720,
      "aspectRatio": "9/16",
      "viewportGap": 0,
      "heightGap": 0
    }
  }
}
